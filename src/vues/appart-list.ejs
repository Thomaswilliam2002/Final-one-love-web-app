<!DOCTYPE html>
<html lang="en">

  
<!-- Mirrored from buybootstrap.com/demos/medflex/medflex-admin-dashboard/doctors-list.html by HTTrack Website Copier/3.x [XR&CO'2014], Thu, 15 May 2025 12:16:08 GMT -->
<%- include('head')%>

  <body>

    <!-- Page wrapper starts -->
    <div class="page-wrapper">

      <!-- App header starts -->
      <% if(user.Personnel.type_personnel === 'admin'){%>
        <%- include('header')%>
      <% }else{%>
        <%- include('header-staff')%>
      <% }%>
      <!-- App header ends -->

      <!-- Main container starts -->
      <div class="main-container">

        <!-- Sidebar wrapper starts -->
        <% if(user.Personnel.type_personnel === 'admin'){%>
          <%- include('menu')%>
        <% }else{%>
          <%- include('menu-staff')%>
        <% }%>
        <!-- Sidebar wrapper ends -->

        <!-- App container starts -->
        <div class="app-container">

          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">

            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a href="/index">Accueil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Liste des Appartement
              </li>
            </ol>
            <!-- Breadcrumb ends -->

            <!-- Sales stats starts -->
            
            <!-- Sales stats ends -->

          </div>
          <!-- App Hero header ends -->

          <!-- App body starts -->
          
          <div class="app-body">
            <% if(msg) {%>
              <div class="alert bg-white border alert-dismissible fade show <%= tc %>" role="alert">
                <%= msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% }%>
            <!-- Row starts -->
            <div class="row gx-3">
              <div class="col-sm-12">
                <div class="card">
                  <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="card-title">Listes des Appartements</h5>
                    <a href="/formAddAppart" class="btn btn-primary ms-auto">Ajouter un Appartement</a>
                  </div>
                  <div class="card-body">

                    <!--  aria-controls="basicExample" Table starts id="basicExample" class="table truncate m-0 align-middle dataTable" aria-describedby="basicExample_filter">-->
                    <div class="">
                      <table id="" class="table m-0 customButtone align-middle" data-export-subtitle="Liste des Appartements">
                        <thead class="text-center">
                          <tr>
                            <th class="no-calc">ID</th>
                            <th class="no-calc">Nom</th>
                            <th class="no-calc">Prix</th>
                            <th class="no-calc">Disponibilite</th> 
                            <th class="no-calc">Actions</th>
                          </tr>
                        </thead>
                        <tbody class="text-center">
                          <% appartements.forEach(appartement => { %> 
                            <tr>
                              <td><%= appartement.slug_id %></td>
                              <td>
                                <%= appartement.nom_appart %>
                              </td>
                              <td><%= appartement.prix_appart %></td>
                              <td><%= appartement.dispo_appart %></td>
                              <td>
                                <div class="d-inline-flex gap-1">
                                  <!-- ----------------------------------------------------------------------------------- -->
                                  <%if(['comptable', 'admin'].includes(user.Poste.nom_poste.toLowerCase())){%>
                                    <!-- Card starts appartement.id_appart-->
                                        <!-- Button trigger modal -->
                                        <button type="button" data-bs-toggle="modal"
                                          data-bs-target="#<%= appartement.id_appart %>ModalCenter" class="btn btn-outline-danger btn-sm">
                                          <i class="ri-delete-bin-line"></i>
                                        </button>
                                        <!-- Modal -->
                                        
                                    <!-- Card ends -->
                                  
                                  <!-- ----------------------------------------------------------------------------------------- -->
                                  <a href="/formEditAppart/<%= appartement.id_appart %>" class="btn btn-outline-success btn-sm"
                                    data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Modifier">
                                    <i class="ri-edit-box-line"></i>
                                  </a>
                                <%}%>
                                  <a href="/oneAppart/<%= appartement.id_appart %>" class="btn btn-outline-info btn-sm"
                                    data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Voir les Details">
                                    <i class="ri-eye-line"></i>
                                  </a>
                                </div>
                              </td>
                            </tr>
                          <%}) %>
                        </tbody>
                      </table>
                    </div>
                    <!-- Table ends -->

                    <!-- Modal Delete Row -->
                    
                  </div>
                </div>
              </div>
            </div>
            <!-- Row ends -->

          </div>
          <!-- App body ends -->

          <!-- App footer starts -->
          <div class="app-footer bg-white">
            <span>© OneLove admin 2026</span>
          </div>
          <!-- App footer ends -->

        </div>
        <!-- App container ends -->

      </div>
      <!-- Main container ends -->

    </div>
    <!-- Page wrapper ends -->

    <!-- ========================= -->
    <!-- 🔥 MODALS (SORTIS ICI) -->
    <!-- ========================= -->

    <% appartements.forEach(appartement => { %>
      <%if(['comptable', 'admin'].includes(user.Poste.nom_poste.toLowerCase())){%>
        <div class="modal fade" id="<%= appartement.id_appart %>ModalCenter" tabindex="-1"
          aria-labelledby="<%= appartement.id_appart %>ModalCenterTitle" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="<%= appartement.id_appart %>ModalCenterTitle">
                  Supprimer
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                <p>Voulez-vous vraiment supprimer l'Appartement <%= appartement.nom_appart %> ?</p>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                  annuler
                </button>
                <!-- <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                  Supprimer
                </button> -->
                <form action="/deleteAppart/<%= appartement.id_appart %>?_method=DELETE" method="post">
                  <div class="col-sm-12">
                    <div class="d-flex gap-2 justify-content-end">
                      <button type="submit" class="btn btn-danger">Supprimer</button>
                    </div>
                  </div>
                  
                  <!-- <a href="/deleteAppart/<%= appartement.id_appart %>?_method=DELETE" class="btn btn-danger"
                    data-bs-title="Supprimer">
                    Supprimer
                  </a> -->
              </form>
              </div>
            </div>
          </div>
        </div>
      <%}%>
    <%}) %>

    <!-- *************
			************ JavaScript Files *************
		************* -->
    <!-- Required jQuery first, then Bootstrap Bundle JS -->
    <%- include('script')%>
    <script>
      window.addEventListener("pageshow", function (event) {
        var historyTraversal = event.persisted || 
                               (typeof window.performance != "undefined" && 
                                window.performance.navigation.type === 2);
        if (historyTraversal) {
            // Si l'utilisateur est revenu en arrière, on recharge la page proprement
            window.location.reload();
        }
      });
    </script>
  </body>


