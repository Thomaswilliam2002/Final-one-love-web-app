<!DOCTYPE html>
<html lang="en">

  
<!-- Mirrored from buybootstrap.com/demos/medflex/medflex-admin-dashboard/doctors-list.html by HTTrack Website Copier/3.x [XR&CO'2014], Thu, 15 May 2025 12:16:08 GMT -->
<%- include('head')%>

  <body>

    <!-- Page wrapper starts -->
    <div class="page-wrapper">

      <!-- App header starts -->
      <% if(user.Personnel.type_personnel === 'admin'){%>
        <%- include('header')%>
      <% }else{%>
        <%- include('header-staff')%>
      <% }%>
      <!-- App header ends -->

      <!-- Main container starts -->
      <div class="main-container">

        <!-- Sidebar wrapper starts -->
        <% if(user.Personnel.type_personnel === 'admin'){%>
          <%- include('menu')%>
        <% }else{%>
          <%- include('menu-staff')%>
        <% }%>
        <!-- Sidebar wrapper ends -->

        <!-- App container starts -->
        <div class="app-container">

          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">

            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a href="index.html">Accueil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Liste des Produit
              </li>
            </ol>
            <!-- Breadcrumb ends -->

            <!-- Sales stats starts -->
            
            <!-- Sales stats ends -->

          </div>
          <!-- App Hero header ends -->

          <!-- App body starts -->
          <div class="app-body">

            <!-- Row starts -->
            <div class="row gx-3">
              <div class="col-sm-12">
                <div class="card">
                  <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="card-title">Liste des Produit</h5>
                    <a href="/formAddProduit" class="btn btn-primary ms-auto">Ajouter un nouveau produit</a>
                  </div>
                  <div class="card-body">
                    <% if(msg) {%>
                      <div class="alert bg-white border alert-dismissible fade show <%= tc %>"  role="alert">
                        <b><%= msg %></b>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                      </div>
                    <% }%>
                    <!-- Table starts -->
                    <div class="table-responsive">
                      <table class="table truncate customButtone m-0 align-middle" data-export-subtitle="Liste des Produits">
                        <thead>
                          <tr class="text-center">
                            <th class="no-calc">ID</th>
                            <th class="no-calc">Nom du Produit</th>
                            <th>Quantiter</th>
                            <th class="no-calc">seuil de rappel</th>
                            <th class="no-calc">Categorie</th>
                            <th class="no-calc">Description</th>
                            <th class="no-calc">Actions</th>
                          </tr>
                        </thead>
                        <tbody>
                          <%produits.forEach((produit, index) => {%> 
                            
                          <tr class="text-center">
                            <td><%= produit.slug_id %></td>
                            <td>
                              <%= produit.nom %>
                            </td>
                            <td><%= produit.quantiter %></td>
                            <td><%= produit.seuil %></td>
                            <% categories.forEach(categorie => { if(produit.id_categ === categorie.id_categ){ %>
                              <td><%= categorie.nom %></td>
                            <% }})%>
                            <td><%= produit.description %></td>
                            <td>
                              <div class="d-inline-flex gap-1">
                                
                                <!-- Card starts -->
                                <!-- Button trigger modal -->
                                <button type="button" data-bs-toggle="modal"
                                  data-bs-target="#delete<%= produit.id_produit %>ModalCenter" class="btn btn-outline-danger btn-sm">
                                  <i class="ri-delete-bin-line"></i>
                                </button>
                                <!-- Modal -->
                                <div class="modal fade" id="delete<%= produit.id_produit %>ModalCenter" tabindex="-1"
                                  aria-labelledby="personnel.id_personnelModalCenterTitle" aria-hidden="true">
                                  <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                      <div class="modal-header">
                                        <h5 class="modal-title" id="delete<%= produit.id_produit %>ModalCenterTitle">
                                          Confirmer
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                      </div>
                                      <div class="modal-body">
                                        <p>Voulez-vous vraiment supprimer l'article: <%= produit.nom %> ?</p>
                                      </div>
                                      <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                          annuler
                                        </button>
                                        <form action="/deleteProduit/<%= produit.id_produit %>?_method=DELETE" method="post">
                                          <div class="col-sm-12">
                                            <div class="d-flex gap-2 justify-content-end">
                                              <button type="submit" class="btn btn-danger">Supprimer</button>
                                            </div>
                                          </div>
                                        </form>
                                      </div>
                                    </div>
                                  <!-- </form> -->
                                  </div>
                                </div>
                                <!-- ----------------------------------------------------------------------------------- -->
                                <!-- Card starts -->
                                <!-- Button trigger modal -->
                                <button type="button" data-bs-toggle="modal"
                                  data-bs-target="#update<%= produit.id_produit %>ModalCenter" class="btn btn-outline-success btn-sm">
                                  <i class="ri-edit-box-line"></i>
                                </button>
                                <!-- Modal -->
                                <div class="modal fade" id="update<%= produit.id_produit %>ModalCenter" tabindex="-1"
                                  aria-labelledby="personnel.id_personnelModalCenterTitle" aria-hidden="true">
                                  <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                      <div class="modal-header">
                                        <h5 class="modal-title" id="update<%= produit.id_produit %>ModalCenterTitle" style="white-space: normal; word-wrap: break-word; overflow: break-word;">
                                          Modification 
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                      </div>
                                      <div class="modal-body">
                                        <form action="/updateProduit/<%= produit.id_produit %>?_method=PUT" method="post">
                                          <div class="row gx-3">
                                            <div class="col-sm-12">
                                              <div class="bg-light rounded-2 px-3 py-2 mb-3">
                                                <h6 class="m-0">Details de l'Article</h6>
                                              </div>
                                            </div>
                                            <div class="col-xxl-3 col-lg-6 col-sm-12 col-12">
                                              <div class="mb-3">
                                                <label class="form-label" for="a1">Nom de l'article<span class="text-danger">*</span></label>
                                                <input type="text" class="form-control" id="a1" value="<%= produit.nom %>" placeholder="Entrer le nouveau nom" name="nom" required>
                                              </div>
                                            </div>
                                            <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                                              <div class="mb-3">
                                                <label class="form-label" for="a2">Categorie<span class="text-danger">*</span></label>
                                                <select class="form-select" id="dep" name="categ">
                                                  <% if(categories){ categories.forEach(categorie => {%>
                                                      <option value="<%= categorie.id_categ %>"><%= categorie.nom %></option>
                                                  <% })}else{ %>
                                                    <option value="null">Aucune categorie disponinble</option>
                                                  <% } %>
                                                </select>
                                              </div>
                                            </div>
                                            <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                                              <div class="mb-3">
                                                <label class="form-label" for="a1">Seuil de rappel<span class="text-danger">*</span></label>
                                                <input type="text" class="form-control" id="a1" value="<%= produit.seuil %>" placeholder="Entrer le nouveau nom" name="seuil" required>
                                              </div>
                                            </div>
                                            <div class="col-xxl-3 col-lg-8 col-sm-6">
                                              <div class="mb-3 form-check">
                                                  <label class="form-label" for="a">Lappel par email<span class="text-danger">*</span></label>
                                                  <input type="checkbox" class="form-check-input" value="1" name="rappel" id="a">
                                              </div>
                                            </div>
                                            <div class="col-xxl-12 col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                              <div class="mb-3">
                                                <label class="form-label" for="a8">Description <span class="text-danger">*</span></label>
                                                <textarea class="form-control" id="a8" rows="2" name="desc"><%= produit.description %></textarea>
                                              </div>
                                            </div>
                                          </div>
                                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                            annuler
                                          </button>
                                          <button type="submit" class="btn btn-danger">Appliquer les modification</button>
                                        </form>
                                      </div>
                                    </div>
                                  <!-- </form> -->
                                  </div>
                                </div>
                                  <!-- Card ends -->
                                <!-- ----------------------------------------------------------------------------------- -->
                                <a href="/oneProduit/<%= produit.id_produit %>" class="btn btn-outline-info btn-sm"
                                  data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Historique de l'article">
                                  <i class="ri-eye-line"></i>
                                </a>
                                <!-- -------------------------------------------------------------------------------------------------- -->
                                <!-- Button trigger modal -->
                                <button type="button" class="btn btn-outline-info btn-sm" data-bs-toggle="modal"
                                  data-bs-target="#<%= produit.id_produit %>exampleModalCenter" data-bs-title="Augmenter le nombre en stock">
                                  <i class="ri-file-reduce-line"></i>
                                </button>
                                <!-- Modal -->
                                <div class="modal fade" id="<%= produit.id_produit %>exampleModalCenter" tabindex="-1"
                                  aria-labelledby="<%= produit.id_produit %>exampleModalCenterTitle" aria-hidden="true">
                                  <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                      <div class="modal-header">
                                        <h5 class="modal-title" id="<%= produit.id_produit %>exampleModalCenterTitle">
                                          Modiffication apres Sortie de Produit
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                      </div>
                                      <div class="modal-body">
                                        <!-- Row starts -->
                                        <% if (produit.quantiter >= 1){ if(caisses.length > 0){%>
                                          <form action="/addHSortie/<%= produit.id_produit %>?art=produit" method="post">
                                            <div class="row gx-3">
                                              <div class="col-sm-12">
                                                <div class="bg-light rounded-2 px-3 py-2 mb-3">
                                                  <h6 class="m-0">Details de la Vente</h6>
                                                </div>
                                              </div>
                                              
                                              <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                                                <div class="mb-3">
                                                  <label class="form-label" for="a1">Quantiter/Nombre a retirer<span class="text-danger">*</span></label>
                                                  <input type="number" min="1"  max="<%= produit.quantiter %>" step="0.01" class="form-control" id="a1" placeholder="Entrer le nombre ou la quqntiter" name="nbr" required>
                                                </div>
                                              </div>
                                              <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                                                <div class="mb-3">
                                                  <label class="form-label" for="a2">Prix a l'unité <span class="text-danger">*</span></label>
                                                  <input type="number" min="0" step="0.01" class="form-control" id="a2" placeholder="Entrer le prix unitaire" name="prix" required>
                                                </div>
                                              </div>
                                              <div class="col-sm-12">
                                                <div class="mb-3">
                                                  <label class="form-label" for="a8">Nom de la caisse destinataire<span class="text-danger">*</span></label>
                                                  <select name="dest" class="form-select" id="" required>
                                                    <% if(caisses.length > 0){ caisses.forEach(c => {%>
                                                      <option value="<%= c.id_lieu %>|<%= c.type_lieu %>|<%= c.id_caisse %>" ><%= c.nom %> (<%= c.type_lieu %>)</option>
                                                    <% })}%>
                                                  </select>
                                                </div>
                                              </div>
                                              <div class="col-sm-12">
                                                <div class="mb-3">
                                                  <label class="form-label" for="a8">Commantaire<span class="text-danger">*</span></label>
                                                  <textarea class="form-control" id="a8" placeholder="un commantaire ?" rows="2" name="cmm"></textarea>
                                                </div>
                                              </div>
                                              <input type="hidden" class="form-control" id="a2" name="type" value="produit">
                                              <input type="hidden" class="form-control" id="a2" name="idpro" value="<%= produit.id_produit %>">
                                            </div>
                                            <div class="modal-footer">
                                              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                Annuler
                                              </button>
                                              <button type="submit" class="btn btn-danger">Confirmer le retrait</button>
                                            </div>
                                          </form>
                                        <% } else { %>
                                          <div class="alert bg-white border alert-dismissible fade show text-danger" role="alert">
                                            <b>Imposssible </b> de diminuer le stock ! <br>
                                            Actuellement Aucune caisse n'est enregistrer . <br>
                                            <a href="/formAddCaisse">Enregistrer une Caisse</a> et réessayer.
                                          </div>
                                        <% } %>
                                        <% } else { %>
                                          <div class="alert bg-white border alert-dismissible fade show text-danger" role="alert">
                                            <b>Imposssible </b> de diminuer le stock ! <br>
                                            Actuellement le stock est a <b>0</b> .
                                          </div>
                                        <% } %>
                                        
                                      </div>
                                    </div>
                                  </div>
                                </div>
                                <!-- Card ends -->
                              </div>
                                <!-- -------------------------------------------------------------------------------------------------- -->
                                <button type="button" class="btn btn-outline-info btn-sm" data-bs-toggle="modal"
                                  data-bs-target="#<%= produit.id_produit %>exampleModalCenter<%= produit.id_produit %>" data-bs-title="Di minuer le nombre en stock">
                                  <i class="ri-file-add-line"></i>
                                </button>
                                <!-- Modal -->
                                <div class="modal fade" id="<%= produit.id_produit %>exampleModalCenter<%= produit.id_produit %>" tabindex="-1"
                                  aria-labelledby="<%= produit.id_produit %>exampleModalCenterTitle<%=produit.id_produit %>" aria-hidden="true">
                                  <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                      <div class="modal-header">
                                        <h5 class="modal-title" id="<%= produit.id_produit %>exampleModalCenterTitle<%= produit.id_produit %>">
                                          Modiffication apres Entrer de Produit
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                      </div>
                                      <div class="modal-body">
                                        <!-- Row starts -->
                                        <% if(fournisseurs.length > 0){ %>
                                        <form action="/addHEntrer/<%= produit.id_produit %>?art=produit" method="post">
                                          <div class="row gx-3">
                                            <div class="col-sm-12">
                                              <div class="bg-light rounded-2 px-3 py-2 mb-3">
                                                <h6 class="m-0">Details de l'ajout</h6>
                                              </div>
                                            </div>
                                            <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                                              <div class="mb-3">
                                                <label class="form-label" for="a1">Quantiter/Nombre a ajouter<span class="text-danger">*</span></label>
                                                <input type="number" min="1" step="0.01" class="form-control" id="a1" placeholder="Entrer le nombre ou la quantiter" name="nb" required>
                                              </div>
                                            </div>
                                            <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                                              <div class="mb-3">
                                                <label class="form-label" for="a2">Prix a l'unité <span class="text-danger">*</span></label>
                                                <input type="number" min="0" step="0.01" class="form-control" id="a2" placeholder="Entrer le prix unitaire" name="prix" required>
                                              </div>
                                            </div>
                                            <div class="col-sm-12">
                                              <div class="mb-3">
                                                <label class="form-label" for="a8">Choisisez le Fournisseur<span class="text-danger">*</span></label>
                                                <select name="fournisseur" class="form-select" id="">
                                                  <% if(fournisseurs.length > 0){ fournisseurs.forEach(f => {%>
                                                    <option value="<%= f.id_fournisseur %>" ><%= f.nom %> (<%= f.pseudo %>)</option>
                                                  <% }) }%>
                                                </select>
                                              </div>
                                            </div>
                                            <input type="hidden" class="form-control" id="a2" name="type" value="produit">
                                            <input type="hidden" class="form-control" id="a2" name="idpro" value="<%= produit.id_produit %>">
                                          </div>
                                          </div>
                                          <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                              Annuler
                                            </button>
                                            <button type="submit" class="btn btn-success">Confirmer l'ajout</button>
                                        </form>
                                        <% } else { %>
                                          <div class="alert bg-white border alert-dismissible fade show text-danger" role="alert">
                                            <b>Imposssible </b> de faire l'approvisionnement ! <br>
                                            Actuellement aucun fournisseur n'est enregistrer. <br>
                                            <a href="/addFournisseur#formAddFournisseur">Enregistrer un Fournisseur</a> et réessayer.
                                          </div>
                                        <% } %>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                                <!-- ----------------------------------------------------------------------------------- -->
                              </div>
                            </td>
                          </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    </div>
                    <!-- Table ends -->

                    <!-- Modal Delete Row -->
                    
                  </div>
                </div>
              </div>
            </div>
            <!-- Row ends -->
            <!-- ---------------------------------------------------------------- -->
             <br>
             <!-- ---------------------------------------------------------------- -->
          </div>
          <!-- App body ends -->
          
          <!-- App footer starts -->
          <div class="app-footer bg-white">
            <span>© OneLove admin 2026</span>
          </div>
          <!-- App footer ends -->

        </div>
        <!-- App container ends -->

      </div>
      <!-- Main container ends -->

    </div>
    <!-- Page wrapper ends -->

    <!-- *************
			************ JavaScript Files *************
		************* -->
    <script src="assets/vendor/apex/apexcharts.min.js"></script>
    <%- include('script')%>
    <script>

      window.addEventListener("pageshow", function (event) {
        var historyTraversal = event.persisted || 
                              (typeof window.performance != "undefined" && 
                                window.performance.navigation.type === 2);
        if (historyTraversal) {
            // Si l'utilisateur est revenu en arrière, on recharge la page proprement
            window.location.reload();
        }
      });
        
    </script>
    <script>
      // const dest_label= document.getElementById("dest_label");
      // const dest_id = document.getElementById("dest_id");
      // dest_label.addEventListener("input", () => {
      //   const selectOption = Array.from(dest_label.list.options).find(option => option.value === dest_label.value);
      //   if(selectOption){
      //     dest_id.value = selectOption.getAttribute("data-id")
      //   }
      // })

    </script>
  </body>


