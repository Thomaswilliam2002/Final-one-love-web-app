<!DOCTYPE html>
<html lang="fr">

<%- include('head')%>

<style>
  /* ── Google Font ── */
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

  :root {
    --surface:      #f5f6fa;
    --card:         #ffffff;
    --border:       #e8eaf0;
    --text:         #1a1d2e;
    --muted:        #8b90a7;
    --accent:       #4f6ef7;

    /* section accents */
    --c-success:    #22c55e;
    --c-primary:    #4f6ef7;
    --c-danger:     #ef4444;
    --c-info:       #06b6d4;
    --c-warning:    #f59e0b;
    --c-secondary:  #6b7280;

    --radius:       14px;
    --shadow:       0 2px 12px rgba(0,0,0,.06);
  }

  /* ── Base ── */
  body { font-family:'DM Sans',sans-serif; background:var(--surface); color:var(--text); }

  /* ── Hero breadcrumb ── */
  .app-hero-header { padding:18px 24px; border-bottom:1px solid var(--border); background:var(--card); }
  .breadcrumb { gap:6px; margin:0; }
  .breadcrumb-item + .breadcrumb-item::before { color:var(--muted); }
  .breadcrumb-item a { color:var(--muted); text-decoration:none; font-size:.85rem; }
  .breadcrumb-item.active { color:var(--accent); font-weight:600; font-size:.85rem; }

  /* ── App body ── */
  .app-body { padding:28px 24px; }

  /* ── Section label ── */
  .section-label {
    display:flex; align-items:center; gap:8px;
    font-size:.7rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase;
    color:var(--muted); margin-bottom:14px; margin-top:28px;
  }
  .section-label:first-child { margin-top:0; }
  .section-label::after {
    content:''; flex:1; height:1px; background:var(--border);
  }

  /* ── Stat card ── */
  .stat-card {
    background:var(--card);
    border:1px solid var(--border);
    border-radius:var(--radius);
    box-shadow:var(--shadow);
    padding:20px 22px;
    display:flex; align-items:center; justify-content:space-between;
    transition:box-shadow .2s, transform .2s;
    text-decoration:none; color:inherit;
    height:100%;
  }
  .stat-card:hover {
    box-shadow:0 6px 24px rgba(79,110,247,.12);
    transform:translateY(-2px);
  }

  .stat-info p {
    font-size:.72rem; font-weight:600; letter-spacing:.06em; text-transform:uppercase;
    color:var(--muted); margin:0 0 4px;
  }
  .stat-info h3 {
    font-size:1.75rem; font-weight:700; margin:0; line-height:1;
    font-family:'DM Mono',monospace;
  }
  .stat-info .stat-link {
    font-size:.78rem; font-weight:500; margin-top:6px; display:inline-flex;
    align-items:center; gap:3px; opacity:.8;
  }
  .stat-info .stat-link:hover { opacity:1; }

  /* Icon bubble */
  .stat-icon {
    width:48px; height:48px; border-radius:12px;
    display:flex; align-items:center; justify-content:center;
    font-size:1.25rem; flex-shrink:0;
  }

  /* Color variants */
  .ic-success  { background:#dcfce7; color:var(--c-success); }
  .ic-primary  { background:#eef2ff; color:var(--c-primary); }
  .ic-danger   { background:#fee2e2; color:var(--c-danger);  }
  .ic-info     { background:#cffafe; color:var(--c-info);    }
  .ic-warning  { background:#fef3c7; color:var(--c-warning); }
  .ic-secondary{ background:#f3f4f6; color:var(--c-secondary);}

  .tx-success  { color:var(--c-success); }
  .tx-primary  { color:var(--c-primary); }
  .tx-danger   { color:var(--c-danger);  }
  .tx-info     { color:var(--c-info);    }
  .tx-warning  { color:var(--c-warning); }
  .tx-secondary{ color:var(--c-secondary);}

  /* Finance card (no icon, accent value) */
  .fin-card {
    background:var(--card);
    border:1px solid var(--border);
    border-radius:var(--radius);
    box-shadow:var(--shadow);
    padding:20px 22px;
    height:100%;
    transition:box-shadow .2s, transform .2s;
  }
  .fin-card:hover { box-shadow:0 6px 24px rgba(79,110,247,.1); transform:translateY(-2px); }
  .fin-card p { font-size:.72rem; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); margin:0 0 6px; }
  .fin-card h3 { font-size:1.55rem; font-weight:700; color:var(--accent); margin:0; font-family:'DM Mono',monospace; }

  /* Total mois highlight */
  .fin-card.highlight {
    background:var(--accent); border-color:var(--accent);
  }
  .fin-card.highlight p { color:rgba(255,255,255,.7); }
  .fin-card.highlight h3 { color:#fff; }

  /* ── Footer ── */
  .app-footer { padding:16px 24px; border-top:1px solid var(--border); font-size:.78rem; color:var(--muted); background:var(--card); }

  /* ── Grid gap ── */
  .stats-grid { row-gap:14px; }
</style>

<body>
  <div class="page-wrapper">

    <%- include('header')%>

    <div class="main-container">

      <%- include('menu')%>

      <div class="app-container">

        <!-- Breadcrumb -->
        <div class="app-hero-header d-flex align-items-center">
          <ol class="breadcrumb">
            <li class="breadcrumb-item">
              <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
              <a href="/index">Accueil</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
          </ol>
        </div>

        <!-- Body -->
        <div class="app-body">
          <div class="row gx-3 stats-grid">

            <!-- ── RESSOURCES ── -->
            <div class="col-12">
              <div class="section-label">👥 Ressources</div>
            </div>

            <%- [
              {title:'Employés',      value:data.personnel, link:'/allPersonnel?allType=pas_admin', icon:'ri-team-line',      color:'success'},
              {title:'Appartements',  value:data.nbAppart,  link:'/allAppart',                     icon:'ri-building-line',  color:'primary'},
              {title:'Chambres',      value:data.nbChambre, link:'/allMClose',                     icon:'ri-hotel-bed-line', color:'danger'}
            ].map(item => `
              <div class="col-xxl-3 col-xl-3 col-lg-3 col-md-4 col-sm-6 col-12">
                <a href="${item.link}" class="stat-card d-flex">
                  <div class="stat-info">
                    <p>${item.title}</p>
                    <h3>${item.value}</h3>
                    <span class="stat-link tx-${item.color}">Voir <i class="ri-arrow-right-line"></i></span>
                  </div>
                  <div class="stat-icon ic-${item.color}">
                    <i class="${item.icon}"></i>
                  </div>
                </a>
              </div>
            `).join('') %>

            <!-- ── ACTIVITÉS ── -->
            <div class="col-12">
              <div class="section-label">🍸 Activités</div>
            </div>

            <%- [
              {title:'Bar Simple',  value:data.nbBarSimple,   color:'danger',  icon:'ri-cup-line'},
              {title:'Bar VIP',     value:data.nbBarVip,      color:'info',    icon:'ri-vip-crown-line'},
              {title:'Crazy Club',  value:data.nbCrazyClub,   color:'warning', icon:'ri-fire-line'},
              {title:'Cuisine',     value:data.nbCuisine,     color:'success', icon:'ri-restaurant-line'}
            ].map(item => `
              <div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                <div class="stat-card">
                  <div class="stat-info">
                    <p>${item.title}</p>
                    <h3>${item.value}</h3>
                  </div>
                  <div class="stat-icon ic-${item.color}">
                    <i class="${item.icon}"></i>
                  </div>
                </div>
              </div>
            `).join('') %>

            <!-- ── STOCK ── -->
            <div class="col-12">
              <div class="section-label">📦 Stock & Produits</div>
            </div>

            <%- [
              {title:'Produits',    value:data.nbProduit,          color:'primary',   icon:'ri-shopping-basket-line'},
              {title:'Emballage',   value:data.nbEmballage,        color:'secondary', icon:'ri-box-3-line'},
              {title:'Catégories',  value:data.nbCategorieArticle, color:'success',   icon:'ri-price-tag-3-line'}
            ].map(item => `
              <div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                <div class="stat-card">
                  <div class="stat-info">
                    <p>${item.title}</p>
                    <h3>${item.value}</h3>
                  </div>
                  <div class="stat-icon ic-${item.color}">
                    <i class="${item.icon}"></i>
                  </div>
                </div>
              </div>
            `).join('') %>

            <!-- ── FINANCES ── -->
            <div class="col-12">
              <div class="section-label">💰 Finances</div>
            </div>

            <%- [
              {title:'Recette Bar Simple', value:data.recetteBarSimple,                    highlight:false},
              {title:'Recette VIP',        value:data.recetteBarVip,                       highlight:false},
              {title:'Recette Club',       value:data.recetteCrazyClub,                    highlight:false},
              {title:'Dépenses',           value:data.sum_depense,                         highlight:false},
              {title:'Total du mois',      value:data?.sum_recette_mois[0]?.total || 0,    highlight:true}
            ].map(item => `
              <div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                <div class="fin-card${item.highlight ? ' highlight' : ''}">
                  <p>${item.title}</p>
                  <h3>${item.value} <small style="font-size:.6em;font-weight:400">FCFA</small></h3>
                </div>
              </div>
            `).join('') %>

          </div><!-- row -->
        </div><!-- app-body -->

        <div class="app-footer">
          <span>© OneLove Admin 2026</span>
        </div>

      </div><!-- app-container -->
    </div><!-- main-container -->
  </div><!-- page-wrapper -->

  <!-- Scripts -->
  <script src="assets/vendor/apex/apexcharts.min.js"></script>
  <%- include('script')%>

  <script>
    window.addEventListener("pageshow", function (e) {
      if (e.persisted || (window.performance && window.performance.navigation.type === 2)) {
        window.location.reload();
      }
    });
  </script>
</body>
</html>
