<%- include('head')%>

  <body>

    <!-- Page wrapper starts -->
    <div class="page-wrapper">

      <!-- App header starts -->
      <% if(user.Personnel.type_personnel === 'admin'){%>
        <%- include('header')%>
      <% }else{%>
        <%- include('header-staff')%>
      <% }%>
      <!-- App header ends -->

      <!-- Main container starts -->
      <div class="main-container">

        <!-- Sidebar wrapper starts -->
        <% if(user.Personnel.type_personnel === 'admin'){%>
          <%- include('menu')%>
        <% }else{%>
          <%- include('menu-staff')%>
        <% }%>
        <!-- Sidebar wrapper ends -->

        <!-- App container starts -->
        <div class="app-container">

          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">

            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a href="/index">Accueil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Liste des Appartement
              </li>
            </ol>
            <!-- Breadcrumb ends -->

            <!-- Sales stats starts -->
            
            <!-- Sales stats ends -->

          </div>
          <!-- App Hero header ends -->

          <!-- App body starts -->
          
          <div class="app-body">
            <% if(msg) {%>
              <div class="alert bg-white border alert-dismissible fade show <%= tc %>" role="alert">
                <%= msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% }%>
          
            <div class="row gx-3">
              <div class="col-sm-12">
                <div class="card">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <div>
                            <h5 class="card-title mb-0">Formulaire de creation de RAPPORT</h5>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-primary">DATE: <%= new Date().toLocaleDateString() %></span>
                        </div>
                    </div>
                
                    <div class="card-body" > <!-- 🔥 IMPORTANT -->
                        <form action="" id="rapport-form">
                            <div class="row gx-3 bg-light p-2" style="border-radius: 10px;">
                                <div class="col-sm-12">
                                    <div class="mb-3">
                                        <label class="form-label">
                                            CHOISISEZ LA CAISSE CIBLE:
                                        </label>
                
                                        <select name="caisse" class="form-select" required>
                                            <% if(caisses.length > 0){ caisses.forEach(c => {%>
                                                <option value="<%= c.id_caisse %>">
                                                    <%= c.nom %> (<%= c.type_lieu %>)
                                                </option>
                                            <% })} else {%><option value="">Aucune caisse disponible</option><% } %>
                                        </select>
                
                                    </div>

                                    <div class="mb-3 d-flex flex-column align-items-center bg-success-subtle p-3 rounded-3">

                                        <h4 class="mb-3 text-center">
                                            Définissez la période que couvrira le rapport
                                        </h4>
                                    
                                        <div class="row w-100 justify-content-center">
                                    
                                            <div class="col-md-3 col-sm-6">
                                                <div class="mb-3">
                                                    <label class="form-label">DATE DEBUT:</label>
                                                    <input type="date" name="date_debut" class="form-control">
                                                </div>
                                            </div>
                                    
                                            <div class="col-md-3 col-sm-6">
                                                <div class="mb-3">
                                                    <label class="form-label">HEURE DEBUT:</label>
                                                    <input type="time" name="heure_debut" class="form-control" required>
                                                </div>
                                            </div>
                                    
                                            <div class="col-md-3 col-sm-6">
                                                <div class="mb-3">
                                                    <label class="form-label">DATE FIN:</label>
                                                    <input type="date" name="date_fin" class="form-control" required>
                                                </div>
                                            </div>
                                    
                                            <div class="col-md-3 col-sm-6">
                                                <div class="mb-3">
                                                    <label class="form-label">HEURE FIN:</label>
                                                    <input type="time" name="heure_fin" class="form-control" required>
                                                </div>
                                            </div>

                                            <div class="col-md-3 col-sm-6">
                                              <div class="mb-3">
                                                  <label class="form-label">CYBLE:</label>
                                                  <select name="cyble" class="form-select" required>
                                                    <option value="produit"> Produit </option>
                                                    <option value="emballage"> Emballage </option>
                                                </select>
                                              </div>
                                          </div>
                                    
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <button type="submit" class="btn bg-success-subtle">ENVOYER</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <br>
                <div class="card">
                  <div class="card-header d-flex align-items-center justify-content-between">
                    <div>
                      <h5 class="card-title mb-0">INVENTAIRE DE STOCK ET CALCUL DES RECETTES ET BENEFICE</h5>
                    </div>
                    <div class="text-end">
                      <span class="badge bg-primary">DATE: <%= new Date().toLocaleDateString() %></span>
                    </div>
                  </div>
                  
                  <div class="card-body">
                    <!-- inventaire stock -->
                    <div class="table-responsive" id="rapport">
                        <div class="alert bg-body-secondary border alert-dismissible fade show alert-info>" role="alert">
                            <h3>Le rapport sera afficher ici</h3>
                         </div>
                    </div>
                    <br>
                    <div 
                    
                        style="
                            border-top: 2px solid #007bff; /* Couleur et épaisseur */
                            width: 50%;                    /* Largeur (ex: 50% de la page) */
                            margin: 20px auto;             /* Centre le trait avec de l'espace en haut/bas */
                            opacity: 0.5;                  /* Transparence */
                         "
                        >
                    </div>

                    <!-- Benefice -->
                    <div class="table-responsive" id="benefice">
                        
                    </div>
                  </div>
          
                  <div class="card-footer bg-white">
                    <div class="d-flex justify-content-between">
                      <!-- <span><strong>CAISSIER:</strong> ____________________</span> -->
                      <!-- <button onclick="window.print()" class="btn btn-dark btn-sm">
                        <i class="ri-printer-line"></i> Imprimer le Rapport
                      </button> -->
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- App body ends -->

          <!-- App footer starts -->
          <div class="app-footer bg-white">
            <span>© OneLove admin 2026</span>
          </div>
          <!-- App footer ends -->

        </div>
        <!-- App container ends -->

      </div>
      <!-- Main container ends -->

    </div>
    <!-- Page wrapper ends -->

    <!-- *************
			************ JavaScript Files *************
		************* -->
    <!-- Required jQuery first, then Bootstrap Bundle JS -->
    <%- include('script')%>
    <script src="/sweetalert2/sweetalert2.all.min.js"></script>
    <script>
      window.addEventListener("pageshow", function (event) {
        var historyTraversal = event.persisted || 
                               (typeof window.performance != "undefined" && 
                                window.performance.navigation.type === 2);
        if (historyTraversal) {
            // Si l'utilisateur est revenu en arrière, on recharge la page proprement
            window.location.reload();
        }
      });
      const date_debut = document.querySelector('input[name="date_debut"]');
      const heure_debut = document.querySelector('input[name="heure_debut"]');
      const date_fin = document.querySelector('input[name="date_fin"]');
      const heure_fin = document.querySelector('input[name="heure_fin"]');
      const caisse = document.querySelector('select[name="caisse"]');
      const cyble = document.querySelector('select[name="cyble"]');
      const rapport = document.getElementById('rapport');
      const benefice = document.getElementById('benefice');

      const allCaisse = JSON.parse(`<%- JSON.stringify(caisses) %>`);

        function toMinutes(time) {
            const [h, m] = time.split(':').map(Number);
            return h * 60 + m;
        }
      //======================================================================
      const form = document.querySelector('form');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        //verification lier aux heurs et date
        const date_debutValue = date_debut.value;
        const heure_debutValue = heure_debut.value;
        const date_finValue = date_fin.value;
        const heure_finValue = heure_fin.value;

        if (date_debutValue === '' || heure_debutValue === '' || date_finValue === '' || heure_finValue === '') {
          Swal.fire({
            icon: 'error',
            title: 'Veuillez renseigner les dates et l\'heures de debut et de fin',
            showConfirmButton: true,
          });
          return;
        }

        if (date_debutValue > date_finValue) {
          Swal.fire({
            icon: 'error',
            title: 'La date de début doit être antérieure(inferieur) à la date de fin',
            showConfirmButton: true,
          });
          return;
        }

        if (date_debutValue === date_finValue && toMinutes(heure_debutValue) > toMinutes(heure_finValue)) {
          Swal.fire({
            icon: 'error',
            title: 'L\'heure de début doit être antérieure(inferieur) à l\'heure de fin',
            showConfirmButton: true,
          });
          return;
        }

        const formData = {
          caisse: caisse.value,
          date_debut: date_debut.value,
          heure_debut: heure_debut.value,
          date_fin: date_fin.value,
          heure_fin: heure_fin.value,
          cyble: cyble.value
        }
        // Fonction pour envoyer le rapport avec gestion Swal
        async function envoyerRapport(formData) {
        // 1. Afficher le spinner de chargement
        Swal.fire({
            title: 'Génération du rapport...',
            text: 'Veuillez patienter pendant le calcul des stocks.',
            allowOutsideClick: false,
            showConfirmButton: false,
            didOpen: () => {
            Swal.showLoading();
            }
        });

        // Création d'un timer de 2 secondes minimum
        const timerPromise = new Promise(resolve => setTimeout(resolve, 2000));

        try {
            // 2. Lancer la requête fetch et le timer en parallèle
            const fetchPromise = fetch('/mackeRapport', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData)
            });

            // On attend que les DEUX soient terminés (le fetch ET les 2 secondes)
            const [response] = await Promise.all([fetchPromise, timerPromise]);

            if (!response.ok) {
                throw new Error(`Erreur serveur : ${response.status}`);
            }

            const data = await response.json();

            // 3. Traitement de la réponse
            if (data.type === 'error' || data.type === 'warning') {
            // Cas où le serveur renvoie une erreur métier (ex: caisse vide)
            Swal.fire({
                icon: data.type,
                title: 'Attention',
                text: data.msg,
                confirmButtonColor: '#3085d6'
            });
            } else {
            // Succès
            Swal.fire({
                icon: 'success',
                title: 'Rapport généré !',
                text: 'Les données ont été chargées avec succès.',
                timer: 1500,
                showConfirmButton: false
            }).then(() => {
                // afficher les informations sur la page
                const inventaires = data.inventaire;
                let body = '';
                //=================calcule des totaul===============================
                const totalStockInitial = inventaires.reduce((s,i)=>s+(i.stock_initial||0),0);
                const totalEntree       = inventaires.reduce((s,i)=>s+(i.entree||0),0);
                const totalDisponible   = inventaires.reduce(
                (s,i)=>s+((i.stock_initial||0)+(i.entree||0)),0
                );

                const totalVente        = inventaires.reduce((s,i)=>s+(i.vente||0),0);

                const totalMontant      = inventaires.reduce(
                (s,i)=>s+((i.vente||0)*(i.prix_unitaire||0)),0
                );

                const totalStockFinal   = inventaires.reduce((s,i)=>s+(i.stock_final||0),0);

                //=================calcule des totaul===============================

                
                //====================================== rapport===================================
                for (const item of inventaires) {

                body += `
                    <tr class="text-center align-middle">
                    <td class="fw-bold">${item.id_produit}</td>

                    <td class="col-produit fw-bold">${item.nom_produit}</td>

                    <td class="bg-grey-light text-muted">${item.stock_initial || 0}</td>

                    <td class="bg-grey-light text-muted">${item.entree || 0}</td>

                    <td class="fw-bold">
                        ${(item.stock_initial || 0) + (item.entree || 0)}
                    </td>

                    <td>${item.vente || 0}</td>

                    <td class="fw-bold">${item.prix_unitaire || 0}</td>

                    <td>
                        ${(item.vente || 0) * (item.prix_unitaire || 0)}
                    </td>

                    <td class="bg-grey-light fw-bold text-danger">
                        ${item.stock_final || 0}
                    </td>

                    <td>${item.description || ''}</td>

                    <td>${item.observations || ''}</td>
                    </tr>
                `;
                }

                //recuperer la caisse
                const selectedId = caisse.value; // valeur du select

                const choiseCaise = allCaisse.find(c => c.id_caisse == selectedId);
                window.currentCaisse = choiseCaise;
                window.periode = data.periode

                rapport.innerHTML = '';
                rapport.insertAdjacentHTML('beforeend',`
                    <style>
                        .table-inventory { border: 1px solid #000; font-family: 'Arial', sans-serif; }
                        .table-inventory thead th { 
                            background-color: #d9d9d9 !important; 
                            color: #000; 
                            border: 1px solid #000;
                            font-weight: bold;
                            text-transform: uppercase;
                            font-size: 11px;
                            vertical-align: middle;
                        }
                        .table-inventory td { 
                            border: 1px solid #000 !important;
                            border-collapse:collapse !important; 
                            font-size: 12px;
                            padding: 4px 8px;
                        }
                        .col-id { width: 50px; }
                        .col-produit { min-width: 200px; text-align: left; }
                        .bg-grey-light { background-color: #f2f2f2; }
                    </style>

                    <table class="newCustomButtone table table-inventory m-0" data-export-subtitle="Inventaire du stock de la caisse: ${choiseCaise.nom}">
                        <thead class="text-center align-middle">
                            <tr>
                            <th class="col-id no-calc">ID</th>
                            <th class="col-produit no-calc">Nom du Produit</th>
                            <th>Stock Initial</th>
                            <th>Entrée</th>
                            <th>Stock Disponible</th>
                            <th>Vente</th>
                            <th class="no-calc">Prix Unitaire</th>
                            <th>Montant Vendu</th>
                            <th class="no-calc">Stock Final</th>
                            <th class="no-calc">Description</th>
                            <th class="no-calc">Observations</th>
                            </tr>
                        </thead>
                        <tbody class="text-center">
                            ${body}
                        </tbody>
                    </table>
                `
                );

                setTimeout(() => {

                    const selector = ".newCustomButtone";

                    // Si une table existe déjà, on la détruit avant de recréer
                    if ($.fn.DataTable.isDataTable(selector)) {
                        $(selector).DataTable().destroy();
                    }

                    initCustomTable(".newCustomButtone");

                }, 100);
                //====================================== rapport===================================
                //====================================== benefices===================================
                body = ''
                let totalBenefice = 0
                for (const item of inventaires) {
                    body += `
                        <tr class="text-center align-middle">
                        <td class="fw-bold">${item.id_produit}</td>

                        <td class="col-produit fw-bold">${item.nom_produit}</td>

                        <td class="bg-grey-light text-muted">${item.prix_unitaire_achat || 0}</td>

                        <td class="bg-grey-light text-muted">${item.prix_unitaire|| 0}</td>

                        <td>${item.vente || 0}</td>

                        <td class="fw-bold">${(item.prix_unitaire || 0) * (item.vente || 0) || 0}</td>

                        <td>${((item.prix_unitaire || 0) * (item.vente || 0) || 0) - ((item.prix_unitaire_achat || 0) * (item.vente || 0) || 0)}</td>
                        </tr>
                    `;
                    totalBenefice += ((item.prix_unitaire || 0) * (item.vente || 0) || 0) - ((item.prix_unitaire_achat || 0) * (item.vente || 0) || 0);
                }

                benefice.innerHTML = ''
                benefice.insertAdjacentHTML('beforeend',`
                    <style>
                        .table-inventory { border: 1px solid #000; font-family: 'Arial', sans-serif; }
                        .table-inventory thead th { 
                            background-color: #d9d9d9 !important; 
                            color: #000; 
                            border: 1px solid #000;
                            font-weight: bold;
                            text-transform: uppercase;
                            font-size: 11px;
                            vertical-align: middle;
                        }
                        .table-inventory td { 
                            border: 1px solid #000 !important;
                            border-collapse:collapse !important; 
                            font-size: 12px;
                            padding: 4px 8px;
                        }
                        .col-id { width: 50px; }
                        .col-produit { min-width: 200px; text-align: left; }
                        .bg-grey-light { background-color: #f2f2f2; }
                    </style>

                    <table class="newCustomButtone table table-inventory m-0" data-export-subtitle="Recette et Benefice :${choiseCaise.nom}">
                        <thead class="text-center align-middle">
                            <tr>
                            <th class="col-id no-calc">ID</th>
                            <th class="col-produit no-calc">Nom du Produit</th>
                            <th class="no-calc">Prix Unitaire Achat</th>
                            <th class="no-calc">Prix Unitaire Vente</th>
                            <th>Vente</th>
                            <th>Montant Vendu</th>
                            <th>Benefice</th>
                            </tr>
                        </thead>
                        <tbody class="text-center">
                            ${body}
                        </tbody>
                    </table>
                `
                );

                setTimeout(() => {

                    const selector = ".newCustomButtone";

                    // Si une table existe déjà, on la détruit avant de recréer
                    if ($.fn.DataTable.isDataTable(selector)) {
                        $(selector).DataTable().destroy();
                    }

                    initCustomTable(".newCustomButtone");

                }, 100);

                // Optionnel : Rediriger ou mettre à jour l'affichage ici
                // window.location.reload(); 
            });
            
            }

        } catch (error) {
            // 4. Gestion des erreurs réseau ou crash serveur
            console.error("Erreur détaillée:", error);
            Swal.fire({
            icon: 'error',
            title: 'Erreur critique',
            text: 'Impossible de contacter le serveur. Vérifiez votre connexion.',
            confirmButtonColor: '#d33'
            });
        }
        }
        envoyerRapport(formData);
            });
    </script>
  </body>


