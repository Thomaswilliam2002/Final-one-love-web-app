<!DOCTYPE html>
<html lang="en">

<%- include('head')%>

  <body>

    <div class="page-wrapper">

      <% if(user.Personnel.type_personnel === 'admin'){%>
        <%- include('header')%>
      <% }else{%>
        <%- include('header-staff')%>
      <% }%>

      <div class="main-container">

        <% if(user.Personnel.type_personnel === 'admin'){%>
          <%- include('menu')%>
        <% }else{%>
          <%- include('menu-staff')%>
        <% }%>

        <div class="app-container">

          <div class="app-hero-header d-flex align-items-center">
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a href="/index">Accueil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Consommations
              </li>
            </ol>
          </div>

          <div class="app-body">
            <% if(msg) {%>
                <div class="alert bg-white border alert-dismissible fade show <%= tc%>" role="alert">
                <b><%= msg%></b>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% }%>

            <div class="mb-5"></div> <div class="row gx-3" id="formAddconsommations">
              <div class="col-sm-12">
                <div class="card">
                  <div class="card-header">
                    <h5 class="card-title">Ajouter une nouvelle consommations</h5>
                  </div>
                  <div class="card-body">
                    <form action="/addConsommation" method="post">
                        <div class="row gx-3">
                            <div class="col-xxl-3 col-lg-4 col-sm-6">
                                <div class="mb-3">
                                  <label class="form-label">Consommateur</label>
                                  <select name="consommateur" id="" class="form-select" required>
                                      <% personnels.forEach(personnel => { %>
                                          <option value="<%= personnel.Personnel.id_personnel %>" ><%= personnel.Personnel.nom %> <%= personnel.Personnel.prenom %> (<%= personnel.Poste.nom_poste %>)</option>
                                      <% }) %>
                                  </select>
                                </div>
                              </div>
                              <div class="col-xxl-3 col-lg-4 col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label">Marqueur</label>
                                  <input type="text" class="form-control" value="<%= user.Personnel.nom %> <%= user.Personnel.prenom %>" readonly required>
                                </div>
                              </div>
                              <input type="hidden" class="form-control" value="<%= user.Personnel.id_personnel %>" name="marqueur">
                              <div class="col-xxl-3 col-lg-4 col-sm-6">
                                <div class="mb-3">
                                  <label class="form-label">Type de Consommateur</label>
                                  <select class="form-select" name="type_consommateur" required>
                                    <option value="Administration">Administration</option>
                                    <option value="Personnel">Personnel</option>
                                  </select>
                                </div>
                              </div>
                              <div class="col-xxl-3 col-lg-4 col-sm-6">
                                <div class="mb-3">
                                  <label class="form-label">Lieu de Consommation</label>
                                    <select name="lieu" id="" class="form-select" required>
                                        <% allBs.forEach(bs => { %>
                                            <option value="<%= bs.nom %>" ><%= bs.nom %></option>
                                        <% }) %>
                                        <% allBv.forEach(bv => { %>
                                            <option value="<%= bv.nom %>" ><%= bv.nom %></option>
                                        <% }) %>
                                        <% allCc.forEach(cc => { %>
                                            <option value="<%= cc.nom %>" ><%= cc.nom %></option>
                                        <% }) %>
                                        <% allAp.forEach(ap => { %>
                                            <option value="<%= ap.nom_appart %>" ><%= ap.nom_appart %></option>
                                        <% }) %>
                                        <% allMc.forEach(mc => { %>
                                            <option value="<%= mc.nom %>" ><%= mc.nom %></option>
                                        <% }) %>
                                        <% allCuis.forEach(cui => { %>
                                            <option value="<%= cui.nom_cuisine %>" ><%= cui.nom_cuisine %></option>
                                        <% }) %>
                                    </select>
                                </div>
                              </div>
                              <div class="col-xxl-3 col-lg-4 col-sm-6">
                                <div class="mb-3">
                                  <label class="form-label">Article</label>
                                  <input type="text" class="form-control"  name="article" required>
                                </div>
                              </div>
                              <div class="col-xxl-3 col-lg-4 col-sm-6">
                                <div class="mb-3">
                                  <label class="form-label">Quantiter</label>
                                  <input type="number" min="1" class="form-control" required name="quantiter">
                                </div>
                              </div>
                              <div class="col-xxl-3 col-lg-4 col-sm-6">
                                  <div class="mb-3">
                                    <label class="form-label">Prix Unitaire</label>
                                    <input type="number" min="0" class="form-control" step="0.01" name="prix_unit">
                                  </div>
                                </div>
                              <div class="col-xxl-3 col-lg-4 col-sm-12">
                                <div class="mb-3">
                                  <label class="form-label">Commantaire</label>
                                  <textarea class="form-control" rows="2" name="commentaire" placeholder="Commantaire"></textarea>
                                </div>
                              </div>
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">Ajouter la consommation</button>
                        </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>

            <br>
            <br>
            
            <div class="row gx-3">
              <div class="col-sm-12">
                <div class="card">
                  <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="card-title">Liste des consommations</h5>
                    <a href="#formAddconsommations" class="btn btn-primary ms-auto">Ajouter une nouvelle consommations</a>
                  </div>
                  <div class="card-body">
                    <div class="table-responsive">
                      <table class="table truncate customButtone m-0 align-middle dataTable" data-export-subtitle="Liste des Consommations">
                        <thead class="text-center align-middle">
                          <tr>
                            <th class="no-calc">ID</th>
                            <th class="no-calc">Consommateur</th>
                            <th class="no-calc">Marqueur</th>
                            <th class="no-calc">Type consommateur</th>
                            <th class="no-calc">Lieu de consommation</th>
                            <th class="no-calc">Article consommer</th>
                            <th>Quantiter</th>
                            <th class="no-calc">Prix a l'uniter</th>
                            <th>Montant</th>
                            <th class="no-calc">Date et heure de l'operation</th>
                            <th class="no-calc">Commantaire</th>
                            <th class="no-calc">Action</th>
                          </tr>
                        </thead>
                        <tbody class="text-center align-middle" id="tbody">
                          <% consommations.forEach(consommation => { %>
                            <tr>
                              <td><%= consommation.slug_id %></td>
                              <td><%= consommation.detailsConsommateur.nom %> <%= consommation.detailsConsommateur.prenom %></td>
                              <td><%= consommation.detailsMarqueur.nom %> <%= consommation.detailsMarqueur.prenom %></td>
                              <td><%= consommation.type_consommateur %></td>
                              <td><%= consommation.lieu %></td>
                              <td><%= consommation.article %></td>
                              <td><%= consommation.quantiter %></td>
                              <td><%= consommation.prix_unit %></td>
                              <td><%= Number(consommation.quantiter * consommation.prix_unit) %></td>
                              <td><%= consommation.date %> a <%= consommation.heure %></td>
                              <td><%= consommation.commantaire %></td>
                              <td>
                                <div class="d-inline-flex gap-1">
                                    <button type="button" data-bs-toggle="modal" data-bs-target="#del<%= consommation.id_conso %>" class="btn btn-outline-danger btn-sm">
                                        <i class="ri-delete-bin-line"></i>
                                    </button>
                                    
                                    <button type="button" data-bs-toggle="modal" data-bs-target="#edit<%= consommation.id_conso %>" class="btn btn-outline-success btn-sm">
                                        <i class="ri-edit-box-line"></i>
                                    </button>
                                </div>

                                <div class="modal fade" id="del<%= consommation.id_conso %>" tabindex="-1" aria-hidden="true">
                                  <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                      <div class="modal-header">
                                        <h5 class="modal-title">Confirmer la suppression</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                      </div>
                                      <div class="modal-body">
                                        <p>Voulez-vous vraiment supprimer cette <strong> consommations</strong> ?</p>
                                      </div>
                                      <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                        <form action="/deleteConsommation/<%= consommation.id_conso %>?_method=DELETE" method="post">
                                            <button type="submit" class="btn btn-danger">Supprimer</button>
                                        </form>
                                      </div>
                                    </div>
                                  </div>
                                </div>

                                <div class="modal fade" id="edit<%= consommation.id_conso %>" tabindex="-1" aria-hidden="true">
                                  <div class="modal-dialog modal-xl">
                                    <div class="modal-content">
                                      <div class="modal-header">
                                        <h5 class="modal-title">Modification des information de la Consommation</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                      </div>
                                      <form action="/updateConsommation/<%= consommation.id_conso %>?_method=PUT" method="post">
                                        <div class="modal-body text-start">
                                          <div class="row gx-3">
                                            <div class="col-xxl-3 col-lg-4 col-sm-6">
                                              <div class="mb-3">
                                                <label class="form-label">Consommateur</label>
                                                <select name="consommateur" id="" class="form-select" required>
                                                    <% personnels.forEach(personnel => { %>
                                                        <option value="<%= personnel.Personnel.id_personnel %>" <%= consommation.consommateur == personnel.Personnel.id_personnel ? 'selected' : '' %> ><%= personnel.Personnel.nom %> <%= personnel.Personnel.prenom %> (<%= personnel.Poste.nom_poste %>)</option>
                                                    <% }) %>
                                                </select>
                                              </div>
                                            </div>
                                            <div class="col-xxl-3 col-lg-4 col-sm-6">
                                              <div class="mb-3">
                                                <label class="form-label">Marqueur</label>
                                                <input type="text" class="form-control" value="<%= consommation.detailsMarqueur.nom %> <%= consommation.detailsMarqueur.prenom %>" readonly required>
                                              </div>
                                            </div>
                                            <input type="hidden" class="form-control" value="<%= consommation.detailsMarqueur.id_personnel %>" name="marqueur" required>
                                            <div class="col-xxl-3 col-lg-4 col-sm-6">
                                              <div class="mb-3">
                                                <label class="form-label">Type de Consommateur</label>
                                                <select value="<%= consommation.type_consommateur %>" class="form-select" name="type_consommateur" required>
                                                  <option value="Administration" <%= consommation.type_consommateur == 'Administration' ? 'selected' : '' %> >Administration</option>
                                                  <option value="Personnel" <%= consommation.type_consommateur == 'Personnel' ? 'selected' : '' %>>Personnel</option>
                                                </select>
                                              </div>
                                            </div>
                                            <div class="col-xxl-3 col-lg-4 col-sm-6">
                                              <div class="mb-3">
                                                <label class="form-label">Lieu de Consommation</label>
                                                <input type="text" class="form-control" value="<%= consommation.lieu %>" name="lieu" required readonly>
                                              </div>
                                            </div>
                                            <div class="col-xxl-3 col-lg-4 col-sm-6">
                                              <div class="mb-3">
                                                <label class="form-label">Article</label>
                                                <input type="text" class="form-control" value="<%= consommation.article %>" name="article">
                                              </div>
                                            </div>
                                            <div class="col-xxl-3 col-lg-4 col-sm-6">
                                              <div class="mb-3">
                                                <label class="form-label">Quantiter</label>
                                                <input type="number" min="1" class="form-control" value="<%= consommation.quantiter %>" name="quantiter">
                                              </div>
                                            </div>
                                            <div class="col-xxl-3 col-lg-4 col-sm-6">
                                                <div class="mb-3">
                                                  <label class="form-label">Prix Unitaire</label>
                                                  <input type="number" min="0" class="form-control" step="0.01" value="<%= consommation.prix_unit %>" name="prix_unit">
                                                </div>
                                              </div>
                                            <div class="col-xxl-3 col-lg-4 col-sm-12">
                                              <div class="mb-3">
                                                <label class="form-label">Commantaire</label>
                                                <textarea class="form-control" rows="2" name="commentaire" placeholder="Commantaire"><%= consommation.commantaire %></textarea>
                                              </div>
                                            </div>
                  
                                          </div>
                                        </div>
                                        <div class="modal-footer">
                                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                          <button type="submit" class="btn btn-primary">Appliquer les modifications</button>
                                        </div>
                                      </form>
                                    </div>
                                  </div>
                                </div>
                              </td>
                            </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="app-footer bg-white">
            <span>© OneLove admin 2026</span>
          </div>

        </div>
        </div>
      </div>
    <%- include('script')%>
    
    <script>
      window.addEventListener("pageshow", function (event) {
        if (event.persisted || (typeof window.performance != "undefined" && window.performance.navigation.type === 2)) {
            window.location.reload();
        }
      });
    </script>
  </body>
</html>