    <!-- Required jQuery first, then Bootstrap Bundle JS -->
    <%- include('script')%>
    <script src="/sweetalert2/sweetalert2.all.min.js"></script>
    <script>
      window.addEventListener("pageshow", function (event) {
        var historyTraversal = event.persisted || 
                               (typeof window.performance != "undefined" && 
                                window.performance.navigation.type === 2);
        if (historyTraversal) {
            // Si l'utilisateur est revenu en arrière, on recharge la page proprement
            window.location.reload();
        }
      });
      const btn = document.getElementById('btn');
      const formbc = document.getElementById('formebc');
      const formap = document.getElementById('formeap');
      const dette = document.getElementById('dette');
      const detteS = document.getElementById('dette_systeme');
      const total = document.getElementById('total');
      const formcui = document.getElementById('formecui');
      const formmc = document.getElementById('formemc');
      const formsp = document.getElementById('formesp');
      const bc = document.getElementById('bc');
      const mclose = document.getElementById('mclose1');
      const chambre = document.getElementById('chambre2');
      const chambres = JSON.parse('<%- JSON.stringify(chambres || []) %>');
      // console.log(chambres)
      const appart = document.getElementById('chambre1');

      function errorTraitement(msg){
        Swal.fire({
          title: 'Attention',
          text: `${msg}`,
          icon: 'warning',
          confirmButtonColor: '#3085d6', // Tu peux mettre ta couleur de thème ici
          confirmButtonText: 'OK',
          background: '#ffffff',
          showClass: {
              popup: 'animate__animated animate__fadeInDown' // Animation fluide
          }
        });
      }

      if(formbc){
        formbc.addEventListener('submit', (e) => {
        e.preventDefault();

          if (!bc.value || !bc.value.includes(' ')) return errorTraitement('Choisissez un bar/club avant de continuer');

          const type = bc.value.split(' ')[1];
          if (type === 'bs') formbc.action = "/addBSJournal";
          if (type === 'bv') formbc.action = "/addBVJournal";
          if (type === 'cc') formbc.action = "/addCCJournal";
          if (type === 'sp') formbc.action = "/addSPJournal";

          formbc.submit();
          return;
        });
      }

      if(formap){
        formap.addEventListener('submit', (e) => {
          e.preventDefault();
          if (appart) {
            if (!appart.value || appart.value === "null") {
              return errorTraitement('Choisissez un appartement avant de continuer');
            }
            formap.submit();
            return;
          }
          return errorTraitement('Choisissez un appartement avant de continuer');
        })
      }

      if(formcui){
        formcui.addEventListener('submit', (e) => {
          e.preventDefault();
          const cuisine = document.querySelector('select[name="cuisine"]');
          if (cuisine) {
            if (!cuisine.value || cuisine.value === "null") {
              return errorTraitement('Choisissez une cuisine avant de continuer')
            }
            formcui.submit();
            return;
          }
          return errorTraitement('Choisissez une cuisine avant de continuer');
        })
      }

      if(formsp){
        formcui.addEventListener('submit', (e) => {
          e.preventDefault();
          const salon = document.querySelector('select[name="salonp"]');
          if (salon) {
            if (!salon.value || salon.value === "null") {
              return errorTraitement('Choisissez un salon Privé avant de continuer');
            }
            formcui.submit();
            return;
          }
          return errorTraitement('Choisissez un salon Privé avant de continuer');
        })
      }

      if(formmc){
        formmc.addEventListener('submit', (e) => {
          e.preventDefault();
          if (mclose) {
            if (!mclose.value || mclose.value === "null") {
              return errorTraitement('Choisissez une maison close avant de continuer');
            }

            // Vérifie si chambre est sélectionnée
            if (!chambre.value || chambre.value === "null") {
              return errorTraitement('Choisissez une chambre avant de continuer');
            }

            formmc.submit();
            return;
          }
          return errorTraitement('Choisissez une maison close avant de continuer');
        })
      }

      mclose.addEventListener('change', () => {
        chambre.innerHTML = ''; //<option value="null">Aucune chambre</option>

        chambres.forEach(ch => {
          if (mclose.value == ch.id_mclose) {
            chambre.insertAdjacentHTML(
              'beforeend',
              `<option value="${ch.id_chambre}">${ch.nom}</option>`
            );
            total.value=ch.total
            dette.value=ch.dette_manuelle 
            detteS.value=ch.manquant_total_systeme
          }
        });
      });

      chambre.addEventListener('change', () => {
        const elementid = chambre.value
        const element = chambres.find((ch) => {return ch.id_chambre == elementid})
        total.value=element.total
        dette.value=element.dette_manuelle 
        detteS.value=element.manquant_total_systeme
      });

    </script>
  </body>

