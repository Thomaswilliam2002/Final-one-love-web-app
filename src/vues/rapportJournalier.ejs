<%- include('head')%>

  <body>

    <!-- Page wrapper starts -->
    <div class="page-wrapper">

      <!-- App header starts -->
      <% if(user.Personnel.type_personnel === 'admin'){%>
        <%- include('header')%>
      <% }else{%>
        <%- include('header-staff')%>
      <% }%>
      <!-- App header ends -->

      <!-- Main container starts -->
      <div class="main-container">

        <!-- Sidebar wrapper starts -->
        <% if(user.Personnel.type_personnel === 'admin'){%>
          <%- include('menu')%>
        <% }else{%>
          <%- include('menu-staff')%>
        <% }%>
        <!-- Sidebar wrapper ends -->

        <!-- App container starts -->
        <div class="app-container">

          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">

            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a href="/index">Accueil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Liste des Appartement
              </li>
            </ol>
            <!-- Breadcrumb ends -->

            <!-- Sales stats starts -->
            
            <!-- Sales stats ends -->

          </div>
          <!-- App Hero header ends -->

          <!-- App body starts -->
          
          <div class="app-body">
            <% if(msg) {%>
              <div class="alert bg-white border alert-dismissible fade show <%= tc %>" role="alert">
                <%= msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% }%>
            <!-- Row starts -->
            <div class="row gx-3">
              <div class="col-sm-12">
                <div class="card">
                  <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="card-title">Rapport</h5>
                    <a href="/formAddAppart" class="btn btn-primary ms-auto">Ajouter un Appartement</a>
                  </div>
                  <div class="card-body">

                    <!--  aria-controls="basicExample" Table starts id="basicExample" class="table truncate m-0 align-middle dataTable" aria-describedby="basicExample_filter">-->
                    <div class="table-responsive">
                      <style>
                        table {
                            width: 100%;
                            border-collapse: collapse;
                            border: 2px solid black;
                        }
                        th, td {
                            border: 1px solid black;
                            height: 25px;
                            text-align: center;
                            padding: 4px;
                        }
                        .header-title {
                            font-size: 18px;
                            font-weight: bold;
                            text-decoration: underline;
                            border-bottom: none;
                        }
                        .header-date {
                            font-weight: bold;
                            border-top: none;
                        }
                        .label-cell {
                            text-align: left;
                            font-weight: bold;
                            padding-left: 10px;
                            background-color: #f9f9f9;
                        }
                        .total-row {
                            font-weight: bold;
                            background-color: #eeeeee;
                        }
                        /* Style spécifique pour les colonnes DG */
                        .dg-header {
                            font-weight: bold;
                        }
                      </style>
                        <table class="customButtone">
                          <thead>
                              <tr>
                                  <th colspan="11" class="header-title">ONE LOVE</th>
                              </tr>
                              <tr>
                                  <th colspan="11" class="header-date">RAPPORT JOURNALIER DU &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; / &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; / 20</th>
                              </tr>
                              <tr>
                                  <th rowspan="2" style="width: 40px;">N° d'ordre</th>
                                  <th rowspan="2" style="width: 200px;">LIBELLE</th>
                                  <th rowspan="2">ARRIERE</th>
                                  <th rowspan="2">NOUVELLE RECETTE</th>
                                  <th rowspan="2">TOTAL</th>
                                  <th rowspan="2">RECU</th>
                                  <th colspan="2" class="dg-header">DG</th>
                                  <th rowspan="2">RESTE</th>
                                  <th rowspan="2" style="width: 150px;">OBSERVATION</th>
                              </tr>
                              <tr>
                                  <th>CONSO</th>
                                  <th>DEPENSES</th>
                              </tr>
                          </thead>
                          
                          <tbody>
                              <tr><td>1</td><td class="label-cell">CRAZY CLUB</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                              <tr><td>2</td><td class="label-cell">VIP 1</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                              <tr><td>3</td><td class="label-cell">BAR SIMPLE 1</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                              <tr><td>4</td><td class="label-cell">BAR SIMPLE 2</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                              <tr><td>5</td><td class="label-cell">BAR APPARTEMENT</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                              <tr><td>6</td><td class="label-cell">MAISON CLOSE 1</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                              <tr><td>7</td><td class="label-cell">MAISON CLOSE 2</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                              <tr><td>8</td><td class="label-cell">APPARTEMENT 1</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                              <tr><td>9</td><td class="label-cell">APPARTEMENT 2</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                              <tr><td>10</td><td class="label-cell">APPARTEMENT 3</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                              <tr><td>11</td><td class="label-cell">APPARTEMENT 4</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                              <tr><td>12</td><td class="label-cell">SALON PRIVE</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                              <tr><td>13</td><td class="label-cell">CUISINE APPARTEMENT</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                              <tr><td>14</td><td class="label-cell">CUISINE CRAZY CLUB</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                              <tr><td>15</td><td class="label-cell">CUISINE BAR SIMPLE 1</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                          </tbody>
                  
                          <tfoot>
                              <tr class="total-row">
                                  <td colspan="2">TOTAL</td>
                                  <td></td>
                                  <td></td>
                                  <td></td>
                                  <td></td>
                                  <td></td>
                                  <td></td>
                                  <td></td>
                                  <td></td>
                              </tr>
                          </tfoot>
                      </table>
                    </div>
                    <!-- Table ends -->

                    <!-- Modal Delete Row -->
                    
                  </div>
                </div>
              </div>
            </div>
            <!-- Row ends -->

          </div>
          <!-- App body ends -->

          <!-- App footer starts -->
          <div class="app-footer bg-white">
            <span>© OneLove admin 2026</span>
          </div>
          <!-- App footer ends -->

        </div>
        <!-- App container ends -->

      </div>
      <!-- Main container ends -->

    </div>
    <!-- Page wrapper ends -->

    <!-- *************
			************ JavaScript Files *************
		************* -->
    <!-- Required jQuery first, then Bootstrap Bundle JS -->
    <%- include('script')%>
    <script>
      window.addEventListener("pageshow", function (event) {
        var historyTraversal = event.persisted || 
                               (typeof window.performance != "undefined" && 
                                window.performance.navigation.type === 2);
        if (historyTraversal) {
            // Si l'utilisateur est revenu en arrière, on recharge la page proprement
            window.location.reload();
        }
      });
    </script>
  </body>


